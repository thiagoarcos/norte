# Copiá este archivo como .env.local y completá con los datos de tu proyecto de Supabase
# (Supabase → Project Settings → API). Sin esto la app funciona en "modo local" (sin cuentas).
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Solo para la build de Android (mapa de Google). En Expo Go no hace falta.
GOOGLE_MAPS_API_KEY=
